{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "paths": {
      "#types": ["./types"],
      "#types/*": ["./types/*"],
      "#data": ["./data"],
      "#data/*": ["./data/*"],
      "#astro": ["./astro"],
      "#astro/*": ["./astro/*"],
      "#lunar": ["./lunar"],
      "#lunar/*": ["./lunar/*"]
    }
  },
  "include": ["./types/**/*", "./data/**/*", "./astro/**/*", "./lunar/**/*", "./tests/**/*"]
}
